# Copy to .env and fill in the key, or export these in your shell.
# Only OPENROUTER_API_KEY is required to reproduce the live-LLM experiments.
# Replay mode (scripts/run_all.ps1 -Replay) needs no credential at all.

OPENROUTER_API_KEY=
# Primary decision model. agent/providers.py refuses any id without a ':free' suffix.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Ordered fallback chain used when the primary model is rate-limited or returns no content.
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SELFX_DECISION_PROVIDER=openrouter
SELFX_LLM_CACHE=1
OPENROUTER_REQUEST_GAP_SEC=1.2

# Optional second provider (not used by the reported experiments)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite



# =============================================================================
# GLOBAL / REPRODUCIBILITY
# =============================================================================
# Set to 1 to cache LLM responses on disk (scripts/run_all.ps1 -Replay needs no key)
SELFX_LLM_CACHE=1
# Seconds to wait between consecutive API calls (avoid rate limits)
OPENROUTER_REQUEST_GAP_SEC=1.2
# Provider used for decision-making (openrouter | gemini | openai | anthropic | ...)
SELFX_DECISION_PROVIDER=openrouter

# =============================================================================
# OPENROUTER (primary for reported experiments)
# =============================================================================
OPENROUTER_API_KEY=
# Primary decision model. Must end with ':free' for the current provider policy.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Ordered fallback chain when primary is rate-limited or returns no content.
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# =============================================================================
# ANTHROPIC
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# =============================================================================
# GOOGLE GEMINI
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =============================================================================
# AZURE OPENAI
# =============================================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# =============================================================================
# AWS BEDROCK
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v1:0

# =============================================================================
# MISTRAL
# =============================================================================
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# =============================================================================
# COHERE
# =============================================================================
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# =============================================================================
# REPLICATE
# =============================================================================
REPLICATE_API_TOKEN=
REPLICATE_MODEL=meta/llama-3.1-8b-instruct

# =============================================================================
# HUGGING FACE
# =============================================================================
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# =============================================================================
# LOCAL / SELF-HOSTED MODELS
# =============================================================================
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LM Studio (OpenAI-compatible server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# vLLM / TGI / text-generation-webui (OpenAI-compatible)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=local-model

# Custom OpenAI-compatible endpoint
CUSTOM_BASE_URL=
CUSTOM_API_KEY=dummy
CUSTOM_MODEL=local-model

# =============================================================================
# OPTIONAL: EXTRA FALLBACK CHAINS (comma-separated)
# =============================================================================
# You can define named fallback lists for different task types.
EXTRA_FALLBACK_MODELS=anthropic/claude-3.5-sonnet:free,openai/gpt-4o-mini:free,google/gemini-2.5-flash-lite:free

# =============================================================================
# LOCAL MODEL CACHE / OFFLINE REPLAY
# =============================================================================
# Path to a directory containing cached JSON responses for offline replay.
LLM_CACHE_DIR=.llm_cache