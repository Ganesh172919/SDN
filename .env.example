# Copy to .env and fill in the key, or export these in your shell.
# Only OPENROUTER_API_KEY is required to reproduce the live-LLM experiments.
# Replay mode (scripts/run_all.ps1 -Replay) needs no credential at all.

OPENROUTER_API_KEY=
# Primary decision model. agent/providers.py refuses any id without a ':free' suffix.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Ordered fallback chain used when the primary model is rate-limited or returns no content.
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SELFX_DECISION_PROVIDER=openrouter
SELFX_LLM_CACHE=1
OPENROUTER_REQUEST_GAP_SEC=1.2

# Optional second provider (not used by the reported experiments)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
