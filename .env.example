# SELF-X dashboard authentication
SELFX_AUTH_USERNAME=demo
SELFX_AUTH_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-generated-salt$replace-with-generated-digest
SELFX_AUTH_SESSION_TTL=1800
# Set to 1 only when serving over HTTPS.
SELFX_AUTH_SECURE_COOKIE=0

# Dashboard and optional Ryu status target
SDN_WEB_PORT=5000
RYU_REST_BASE=http://127.0.0.1:8080
